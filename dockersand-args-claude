#!/usr/bin/env bash
set -e

# --mount is parsed as CSV: quote each field, doubling any '"'
bind() { printf 'type=bind,"src=%s","dst=%s"' "${1//\"/\"\"}" "${2//\"/\"\"}"; }

# --mount needs the source to exist
[[ -e "$HOME/.claude.json" ]] || touch "$HOME/.claude.json"
mkdir -p "$HOME/.claude" "$HOME/.agents"

printf '%s\n' \
  --mount "$(bind "$HOME/.claude.json" /home/work/.claude.json)" \
  --mount "$(bind "$HOME/.claude" /home/work/.claude)" \
  --mount "$(bind "$HOME/.agents" /home/work/.agents)"
