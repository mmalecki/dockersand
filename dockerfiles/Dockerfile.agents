FROM debian:trixie

RUN apt update -y && apt upgrade -y
RUN apt install -y --no-install-recommends \
    ca-certificates git curl wget unzip zip xz-utils \
    ripgrep fd-find jq less file tree procps \
    build-essential python3 python3-pip python3-venv \
    openssh-client netcat-openbsd gnupg \
 && ln -s /usr/bin/fdfind /usr/local/bin/fd \
 && rm -rf /var/lib/apt/lists/*

ARG YQ_VERSION=latest
RUN if [ "$YQ_VERSION" = latest ]; then yq_path=latest/download; else yq_path="download/$YQ_VERSION"; fi \
 && curl -fsSL -o /usr/local/bin/yq \
    "https://github.com/mikefarah/yq/releases/$yq_path/yq_linux_$(dpkg --print-architecture)" \
 && chmod +x /usr/local/bin/yq

RUN groupadd work
RUN useradd -m work -g work
USER work:work

ARG NODE_VERSION=24
ENV FNM_DIR=/home/work/.fnm
RUN curl -fsSL https://fnm.vercel.app/install | bash -s -- --install-dir "$FNM_DIR" --skip-shell \
 && "$FNM_DIR/fnm" install "$NODE_VERSION" \
 && "$FNM_DIR/fnm" default "$NODE_VERSION"

ENV PATH="$FNM_DIR:$FNM_DIR/aliases/default/bin:/home/work/.npm/bin:$PATH"

RUN npm config set prefix "/home/work/.npm"
