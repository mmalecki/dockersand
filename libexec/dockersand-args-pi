#!/usr/bin/env bash
set -e

# --mount is parsed as CSV: quote each field, doubling any '"'
bind() { printf 'type=bind,"src=%s","dst=%s"' "${1//\"/\"\"}" "${2//\"/\"\"}"; }

# --mount needs this to exist; -v used to create it root-owned
mkdir -p "$HOME/.pi"

printf '%s\n' \
  --mount "$(bind "$HOME/.pi" /home/work/.pi)" \
  -e PARALLEL_API_KEY
